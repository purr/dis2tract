{
  "manifest_version": 2,
  "name": "dis2tract",
  "version": "0.8.0",
  "description": "blocks endless feeds on youtube, x, tiktok, instagram, reddit, facebook, threads, bluesky and linkedin. search, profiles and single posts keep working.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@dis2tract",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/purr/dis2tract/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://x.com/*",
    "*://www.tiktok.com/*",
    "*://us.tiktok.com/*",
    "*://www.instagram.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://www.threads.com/*",
    "*://bsky.app/*",
    "*://www.linkedin.com/*",
    "*://linkedin.com/*",
    "*://*.bsky.network/*",
    "*://public.api.bsky.app/*",
    "*://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "persistent": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_title": "dis2tract settings",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": false,
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://x.com/*",
        "*://www.tiktok.com/*",
        "*://us.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*",
        "*://www.threads.com/*",
        "*://bsky.app/*",
        "*://www.linkedin.com/*",
        "*://linkedin.com/*"
      ],
      "css": [
        "css/overlay.css"
      ],
      "js": [
        "src/ui.js",
        "src/settings.js",
        "src/sites.js",
        "src/challenges.js",
        "src/suggestions.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
